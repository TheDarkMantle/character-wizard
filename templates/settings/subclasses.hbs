<section class="tab {{tab.cssClass}}" data-tab="subclasses" data-group="main">
  <p class="hint">{{localize "CHARWIZ.Settings.Content.SubclassesHint"}}</p>
  {{#each subclassGroups}}
  <fieldset>
    <legend>{{name}}</legend>
    <ul class="charwiz-allow-list">
      {{#each subclasses}}
      <li>
        <label>
          <input type="checkbox" data-block-key="{{key}}" {{checked allowed}}>
          <img src="{{img}}" alt="" width="24" height="24">
          <span class="name">{{name}}</span>
          <span class="meta">{{packLabel}}</span>
        </label>
      </li>
      {{/each}}
    </ul>
  </fieldset>
  {{else}}
  <p class="charwiz-empty">{{localize "CHARWIZ.Settings.Content.NoSubclasses"}}</p>
  {{/each}}
</section>
