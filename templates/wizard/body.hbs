<section class="charwiz-body">
  <h2>{{localize stepLabel}}</h2>

  {{#if isPicker}}
  <div class="charwiz-picker">
    <div class="charwiz-list-column">
      <input type="search" name="query" value="{{query}}" placeholder="{{localize 'CHARWIZ.Search'}}"
        aria-label="{{localize 'CHARWIZ.Search'}}">
      <ul class="charwiz-list">
        {{#each rows}}
        {{#if group}}
        <li class="charwiz-group">
          <button type="button" class="charwiz-group-toggle {{#if containsPick}}picked{{/if}}" data-action="group"
            data-group="{{group}}" aria-expanded="{{#if expanded}}true{{else}}false{{/if}}">
            <i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}" inert></i>
            <span class="name">{{group}}</span>
            <span class="meta">{{count}}</span>
            {{#if containsPick}}<i class="fa-solid fa-circle-check" inert></i>{{/if}}
          </button>
          {{#if expanded}}
          <ul class="charwiz-sublist">
            {{#each entries}}
            <li>
              <button type="button" class="charwiz-entry {{#if focused}}focused{{/if}} {{#if picked}}picked{{/if}}"
                data-action="focus" data-uuid="{{uuid}}">
                <img src="{{img}}" alt="" width="36" height="36">
                <span class="name">{{name}}</span>
                <span class="meta">{{#if book}}{{book}}{{else}}{{packLabel}}{{/if}}{{#if otherRules}} · {{localize "CHARWIZ.OtherRules" rules=otherRules}}{{/if}}</span>
                {{#if picked}}<i class="fa-solid fa-circle-check" inert></i>{{/if}}
              </button>
            </li>
            {{/each}}
          </ul>
          {{/if}}
        </li>
        {{else}}
        <li>
          <button type="button" class="charwiz-entry {{#if entry.focused}}focused{{/if}} {{#if entry.picked}}picked{{/if}}"
            data-action="focus" data-uuid="{{entry.uuid}}">
            <img src="{{entry.img}}" alt="" width="36" height="36">
            <span class="name">{{entry.name}}</span>
            <span class="meta">{{#if entry.book}}{{entry.book}}{{else}}{{entry.packLabel}}{{/if}}{{#if entry.otherRules}} · {{localize "CHARWIZ.OtherRules" rules=entry.otherRules}}{{/if}}</span>
            {{#if entry.picked}}<i class="fa-solid fa-circle-check" inert></i>{{/if}}
          </button>
        </li>
        {{/if}}
        {{else}}
        <li class="charwiz-empty">{{localize "CHARWIZ.NoOptions"}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="charwiz-preview">
      {{#if preview}}
      <header>
        <img src="{{preview.img}}" alt="" width="64" height="64">
        <div>
          <h3>{{preview.name}}</h3>
          <span class="meta">{{preview.source}}</span>
        </div>
        <button type="button" class="charwiz-choose" data-action="choose" data-uuid="{{preview.uuid}}" {{disabled previewPicked}}>
          {{#if previewPicked}}{{localize "CHARWIZ.Chosen"}}{{else}}{{localize "CHARWIZ.Choose"}}{{/if}}
        </button>
      </header>

      <div class="charwiz-board-preview">
        <section>
          <h4><i class="fa-solid fa-lock" inert></i> {{localize "CHARWIZ.Board.Granted"}}</h4>
          <ul>
            {{#each preview.granted}}
            <li><strong>{{title}}</strong>{{#if detail}} — {{detail}}{{/if}}</li>
            {{else}}<li class="charwiz-empty">{{localize "CHARWIZ.Board.None"}}</li>{{/each}}
          </ul>
        </section>
        <section>
          <h4><i class="fa-solid fa-hand-pointer" inert></i> {{localize "CHARWIZ.Board.Choices"}}</h4>
          <ul>
            {{#each preview.choices}}
            <li><strong>{{title}}</strong> <span class="meta">{{countLabel}}</span>{{#if via}} <span class="meta">({{via}})</span>{{/if}}{{#if detail}}<br><span class="pool">{{detail}}</span>{{/if}}</li>
            {{else}}<li class="charwiz-empty">{{localize "CHARWIZ.Board.None"}}</li>{{/each}}
            {{#each preview.native}}
            <li><strong>{{title}}</strong> <span class="meta">{{localize "CHARWIZ.Board.Native"}}</span></li>
            {{/each}}
          </ul>
        </section>
      </div>

      <div class="charwiz-description">{{{preview.description}}}</div>
      {{else}}
      <p class="charwiz-empty">{{localize "CHARWIZ.PickToPreview"}}</p>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if isChoices}}
  <p class="hint">{{localize "CHARWIZ.Choices.Hint" name=itemName}}</p>
  <div class="charwiz-choices">
    <div class="charwiz-slots">
      {{#each slots}}
      <section class="charwiz-slot {{#if complete}}complete{{/if}}">
        <header>
          <h3>{{title}}</h3>
          <span class="meta">{{#unless (eq itemName ../itemName)}}{{itemName}} · {{/unless}}{{progress}}</span>
        </header>
        {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}
        {{#if asi}}
        <ul class="charwiz-points">
          {{#each options}}
          <li class="{{#if inspected}}inspected{{/if}}">
            <span class="name">{{label}}</span>
            <button type="button" data-action="adjust" data-slot="{{../key}}" data-value="{{value}}" data-delta="-1"
              aria-label="{{localize 'CHARWIZ.Choices.Remove' ability=label}}"
              {{#unless canRemove}}disabled{{/unless}}><i class="fa-solid fa-minus" inert></i></button>
            <output aria-live="polite">+{{points}}</output>
            <button type="button" data-action="adjust" data-slot="{{../key}}" data-value="{{value}}" data-delta="1"
              aria-label="{{localize 'CHARWIZ.Choices.Add' ability=label}}"
              {{#unless canAdd}}disabled{{/unless}}><i class="fa-solid fa-plus" inert></i></button>
          </li>
          {{/each}}
        </ul>
        {{#if canReset}}
        <button type="button" class="charwiz-reset" data-action="resetPoints" data-slot="{{key}}">
          <i class="fa-solid fa-rotate-left" inert></i> {{localize "CHARWIZ.Choices.ResetStandard"}}
        </button>
        {{/if}}
        {{else}}
        <ul class="charwiz-options">
          {{#each options}}
          <li>
            <div class="charwiz-option {{#if selected}}selected{{/if}} {{#if inspected}}inspected{{/if}} {{#if disabled}}disabled{{/if}}"
              {{#if disabled}}data-tooltip="CHARWIZ.Choices.Taken"{{/if}}>
              <button type="button" class="charwiz-check" data-action="toggle" data-slot="{{../key}}" data-value="{{value}}"
                aria-pressed="{{#if selected}}true{{else}}false{{/if}}" {{#if disabled}}disabled{{/if}}
                aria-label="{{localize 'CHARWIZ.Choices.Select' name=label}}">
                <i class="fa-solid {{#if selected}}fa-square-check{{else}}fa-square{{/if}}" inert></i>
              </button>
              <button type="button" class="charwiz-option-label" data-action="inspect" data-slot="{{../key}}"
                data-value="{{value}}">
                {{#if img}}<img src="{{img}}" alt="" width="28" height="28">{{/if}}
                <span class="name">{{label}}</span>
              </button>
            </div>
          </li>
          {{/each}}
        </ul>
        {{/if}}
      </section>
      {{/each}}
    </div>
    <div class="charwiz-preview">
      {{#if info}}
      <header>
        {{#if info.img}}<img src="{{info.img}}" alt="" width="48" height="48">{{/if}}
        <div>
          <h3>{{info.name}}</h3>
          {{#if info.kind}}<span class="meta">{{info.kind}}</span>{{/if}}
        </div>
        {{#if info.canChoose}}
        <button type="button" class="charwiz-choose" data-action="toggle" data-slot="{{info.slotKey}}"
          data-value="{{info.value}}">
          {{#if info.selected}}{{localize "CHARWIZ.Choices.Deselect"}}{{else}}{{localize "CHARWIZ.Choose"}}{{/if}}
        </button>
        {{/if}}
      </header>
      <div class="charwiz-description">{{{info.description}}}</div>
      {{else}}
      <p class="charwiz-empty">{{localize "CHARWIZ.Choices.Inspect"}}</p>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if isAbilities}}
  <div class="charwiz-abilities">
    <div class="charwiz-methods" role="group" aria-label="{{localize 'CHARWIZ.Abilities.MethodsLabel'}}">
      {{#each abilities.methods}}
      <button type="button" class="charwiz-method {{#if active}}active{{/if}}" data-action="abilityMethod"
        data-method="{{id}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{localize label}}</button>
      {{/each}}
    </div>
    <p class="hint">{{abilities.hint}}</p>

    {{#if abilities.isRoll}}
    <div class="charwiz-roll">
      <button type="button" data-action="abilityRoll" {{disabled abilities.hasRolled}}>
        <i class="fa-solid fa-dice" inert></i> {{localize "CHARWIZ.Abilities.Roll" formula=abilities.formula}}
      </button>
      {{#if abilities.hasRolled}}<span>{{localize "CHARWIZ.Abilities.Rolled"}}: <strong>{{abilities.rolled}}</strong></span>{{/if}}
    </div>
    {{/if}}
    {{#if abilities.isPointBuy}}
    <p class="charwiz-budget" role="status">{{localize "CHARWIZ.Abilities.PointsLeft" left=abilities.pointsLeft budget=abilities.budget}}</p>
    {{/if}}

    <table class="charwiz-scores">
      <thead>
        <tr>
          <th scope="col">{{localize "CHARWIZ.Abilities.Ability"}}</th>
          <th scope="col">{{localize "CHARWIZ.Abilities.Base"}}</th>
          <th scope="col">{{localize "CHARWIZ.Abilities.Bonus"}}</th>
          <th scope="col">{{localize "CHARWIZ.Abilities.Score"}}</th>
          <th scope="col">{{localize "CHARWIZ.Abilities.Modifier"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each abilities.rows}}
        <tr>
          <th scope="row">{{label}}</th>
          <td class="charwiz-control">
            {{#if isSelect}}
            <select data-ability-input data-ability="{{id}}" aria-label="{{label}}">
              <option value="">—</option>
              {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
            </select>
            {{else if isPoints}}
            <button type="button" data-action="abilityPoint" data-ability="{{id}}" data-delta="-1" {{#unless canDown}}disabled{{/unless}}
              aria-label="{{localize 'CHARWIZ.Choices.Remove' ability=label}}"><i class="fa-solid fa-minus" inert></i></button>
            <output aria-live="polite">{{value}}</output>
            <button type="button" data-action="abilityPoint" data-ability="{{id}}" data-delta="1" {{#unless canUp}}disabled{{/unless}}
              aria-label="{{localize 'CHARWIZ.Choices.Add' ability=label}}"><i class="fa-solid fa-plus" inert></i></button>
            {{else if isNumber}}
            <input type="number" min="1" max="20" step="1" data-ability-input data-ability="{{id}}" value="{{value}}"
              aria-label="{{label}}">
            {{/if}}
          </td>
          <td class="charwiz-bonus">{{bonusLabel}}</td>
          <td class="charwiz-final">{{#if final}}{{final}}{{else}}—{{/if}}</td>
          <td class="charwiz-mod">{{modLabel}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#if abilities.hasBonus}}<p class="hint">{{localize "CHARWIZ.Abilities.BonusNote"}}</p>{{/if}}
  </div>
  {{/if}}

  {{#if isPending}}
  <p class="charwiz-empty">{{localize "CHARWIZ.Pending"}}</p>
  {{/if}}

  {{#if isDetails}}
  <div class="form-group">
    <label for="charwiz-name">{{localize "CHARWIZ.Details.Name"}}</label>
    <input type="text" id="charwiz-name" name="name" value="{{draft.name}}">
  </div>
  {{/if}}

  {{#if isReview}}
  <dl class="charwiz-summary">
    <dt>{{localize "CHARWIZ.Details.Name"}}</dt><dd>{{#if draft.name}}{{draft.name}}{{else}}—{{/if}}</dd>
    {{#if abilityLine}}<dt>{{localize "CHARWIZ.Steps.abilities"}}</dt><dd>{{abilityLine}}</dd>{{/if}}
    {{#each summary}}
    <dt>{{localize label}}</dt>
    <dd>{{#if name}}{{name}}{{else}}—{{/if}}
      {{#each choices}}<br><span class="meta">{{title}}: {{picked}}</span>{{/each}}
    </dd>
    {{/each}}
  </dl>
  {{#if deferred.length}}
  <p class="hint">{{localize "CHARWIZ.Review.Deferred"}} {{#each deferred}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>
  {{/if}}
  <p class="hint">{{localize "CHARWIZ.Review.Scope"}}</p>
  {{#if blocker}}<p class="charwiz-blocker" role="status">{{localize blocker}}</p>{{/if}}
  <button type="button" class="charwiz-create" data-action="create" {{disabled blocker}}>
    <i class="fa-solid fa-hat-wizard" inert></i> {{localize createLabel}}
  </button>
  {{/if}}
</section>
