<div class="standard-form cw-content">
  <nav class="tabs sheet-tabs cw-tabs" aria-label="Character creation steps">
    {{#each steps}}
    <a class="item {{#if active}}active{{/if}}" data-action="step" data-step="{{id}}" data-tab="{{id}}" role="button" tabindex="0" {{#if active}}aria-current="step"{{/if}} {{#if ../busy}}aria-disabled="true"{{/if}}>{{number}}. {{short}}{{#if done}} <i class="fa-solid fa-check" aria-label="Chosen"></i>{{/if}}</a>
    {{/each}}
  </nav>

  <header class="cw-heading">
    <h2>{{step.title}}</h2>
    <p class="hint">{{step.hint}}</p>
    {{#unless isRules}}<p class="hint">Rules: D&D {{ruleset}}</p>{{/unless}}
  </header>
  {{#if error}}<p class="notification error" role="alert">{{error}}</p>{{/if}}

  {{#if isRules}}
  <section class="cw-body standard-form">
    <div class="form-group">
      <label for="{{appId}}-name">Character name</label>
      <div class="form-fields"><input id="{{appId}}-name" name="characterName" type="text" value="{{characterName}}" placeholder="Name" maxlength="120"></div>
      <p class="hint">You can leave this blank and decide later.</p>
    </div>
    <div class="form-group">
      <label for="{{appId}}-rules">Rules version</label>
      <div class="form-fields"><select id="{{appId}}-rules" name="ruleset"><option value="2014" {{#if is2014}}selected{{/if}}>D&D 2014</option><option value="2024" {{#if is2024}}selected{{/if}}>D&D 2024</option></select></div>
      <p class="hint">All choices must match this edition. Changing editions clears your content choices.</p>
    </div>
  </section>
  {{/if}}

  {{#if isBrowse}}
  <section class="cw-browser">
    <div class="form-group cw-toolbar">
      <label for="{{appId}}-search">Search</label>
      <div class="form-fields"><input id="{{appId}}-search" name="search" type="search" value="{{query}}" placeholder="Name or source"><button type="button" data-action="refresh" {{#if busy}}disabled{{/if}} title="Refresh compendium choices"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Refresh</button></div>
    </div>
    {{#if busy}}<p class="hint" role="status">Loading compendium choices…</p>{{/if}}
    {{#if unavailable}}<p class="notification warning" role="status">Could not read: {{unavailable}}. Try Refresh.</p>{{/if}}
    {{#if unclassified}}<p class="hint">{{unclassified}} entries without a recognized edition are hidden.</p>{{/if}}
    <div class="cw-columns">
      <section class="cw-results" aria-label="Available choices">
        <h3>Available choices <span class="hint">({{count}})</span></h3>
        <ol class="directory-list plain cw-list">
          {{#each items}}
          <li class="directory-item">
            <button type="button" class="cw-choice {{#if active}}is-preview{{/if}}" data-action="preview" data-uuid="{{uuid}}" aria-pressed="{{active}}" {{#if ../busy}}disabled{{/if}}>
              {{#if img}}<img class="cw-thumbnail" src="{{img}}" alt="" loading="lazy">{{else}}<i class="fa-solid fa-book cw-thumbnail" aria-hidden="true"></i>{{/if}}
              <span class="cw-choice-text"><strong>{{label}}</strong><span class="hint">{{sourceLabel}}</span>{{#if selected}}<span class="hint"><i class="fa-solid fa-check" aria-hidden="true"></i> Selected</span>{{/if}}</span>
            </button>
          </li>
          {{else}}
          {{#unless busy}}<li class="hint">No matching choices. Check your search and accessible {{ruleset}} compendiums.</li>{{/unless}}
          {{/each}}
        </ol>
      </section>
      <section class="cw-details" aria-label="Choice description" aria-live="polite">
        {{#if preview}}
        <h3>{{preview.label}}</h3><p class="hint">{{preview.sourceLabel}}</p>
        {{#if preview.loading}}<p class="hint" role="status">Loading description…</p>{{else}}
          {{#if preview.noDescription}}<p class="hint">This entry has no description. Open the full entry to inspect its features.</p>{{else}}
            {{#if preview.isClass}}<p class="cw-description">{{preview.summary}}</p>{{else}}<div class="cw-description">{{{preview.html}}}</div>{{/if}}
          {{/if}}
          <div class="cw-detail-actions">
            <button type="button" data-action="full"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Read full {{#if preview.isClass}}class description{{else}}entry{{/if}}</button>
            <button type="button" data-action="choose" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-check" aria-hidden="true"></i> {{#if previewSelected}}Selected{{else}}Choose this option{{/if}}</button>
          </div>
        {{/if}}
        {{else}}
        <h3>Description</h3><p class="hint">Select an entry to read its description.</p>
        {{/if}}
      </section>
    </div>
  </section>
  {{/if}}

  {{#if isReview}}
  <section class="cw-body standard-form">
    <fieldset><legend>Character draft</legend>
      <div class="form-group"><label>Name</label><div class="form-fields">{{#if characterName}}{{characterName}}{{else}}Not entered{{/if}}</div></div>
      <div class="form-group"><label>Rules version</label><div class="form-fields">D&D {{ruleset}}</div></div>
    </fieldset>
    {{#each summary}}
    <fieldset><legend>{{title}}</legend>
      <div class="cw-summary-row"><div>{{#if chosen}}<strong>{{label}}</strong><p class="hint">{{sourceLabel}}</p>{{else}}<p class="hint">Not chosen</p>{{/if}}</div>
        <div class="cw-row-actions"><button type="button" data-action="step" data-step="{{step}}">{{#if chosen}}Change{{else}}Browse{{/if}}</button>{{#if chosen}}<button type="button" data-action="full" data-uuid="{{uuid}}" title="Read full entry"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Read</button><button type="button" data-action="clear" data-step="{{step}}" aria-label="Remove {{title}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</div>
      </div>
    </fieldset>
    {{/each}}
    <p class="hint">This build saves a draft only. Actor creation, ability scores, advancements, and prerequisites are still to come. Feat choices are provisional.</p>
  </section>
  {{/if}}

  <footer class="form-footer cw-footer">
    <button type="button" data-action="back" {{#unless canBack}}disabled{{/unless}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
    {{#if isReview}}<button type="button" data-action="save"><i class="fa-solid fa-download" aria-hidden="true"></i> Save draft to file</button>{{else}}<button type="button" data-action="next" {{#unless canNext}}disabled{{/unless}}>{{nextLabel}} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>{{/if}}
  </footer>
</div>
