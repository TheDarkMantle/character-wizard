<footer class="charwiz-footer">
  <button type="button" data-action="back" {{disabled first}}><i class="fa-solid fa-arrow-left" inert></i> {{localize "CHARWIZ.Back"}}</button>
  {{#if blockLabel}}<span class="charwiz-remaining" role="status">{{blockLabel}}</span>{{/if}}
  {{#unless last}}
  <button type="button" data-action="next" {{disabled blocked}}>{{localize "CHARWIZ.Next"}} <i class="fa-solid fa-arrow-right" inert></i></button>
  {{/unless}}
</footer>
